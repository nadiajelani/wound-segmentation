# Wound Segmentation Environment Configuration
# Copy this file to .env and modify the values as needed

# Model Paths
UNET_WEIGHTS_PATH=models/simclr_unet_patch_wound.keras
CLASSIFIER_WEIGHTS_PATH=models/resnet_classifier.h5

# Output Directories
OUTPUT_DIR=outputs
REPORTS_DIR=reports
PROGRESS_REPORTS_DIR=wound_progress_report

# Device Configuration
DEVICE=auto  # Options: auto, cpu, gpu, mps
MIXED_PRECISION=true

# Feature Flags
ENABLE_EXPLAINABILITY=true
ENABLE_VOICE_SUMMARY=false
ENABLE_SYNTHETIC_DATA=false

# Model Configuration
BATCH_SIZE=1
IMG_SIZE=128
CONFIDENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/wound_segmentation.log

# API Configuration (if using web interface)
API_HOST=localhost
API_PORT=5000
DEBUG=false

# Security (for production)
SECRET_KEY=your-secret-key-here
UPLOAD_MAX_SIZE=10MB

# TensorFlow Configuration
TF_THREADS=0  # 0 = auto, set to number of threads for manual control

# Optional: External Services
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name