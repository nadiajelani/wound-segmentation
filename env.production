# Production Environment Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# Model Paths (will be set by hosting platform)
UNET_MODEL_PATH=/app/models/checkpoints/unet_weights.h5
MEDSAM_MODEL_PATH=/app/models/checkpoints/medsam_model.pth

# Storage Configuration
UPLOAD_FOLDER=/app/uploads
REPORT_FOLDER=/app/reports
LOG_FOLDER=/app/logs

# Security Settings
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
RATE_LIMIT_PER_MINUTE=10
MAX_REQUESTS_PER_HOUR=100

# File Cleanup (in hours)
FILE_CLEANUP_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log