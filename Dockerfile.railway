# Railway-optimized Dockerfile for wound segmentation API
# Python 3.10 + TensorFlow 2.12 compatible

FROM python:3.10-slim

# Install system dependencies for OpenCV and TensorFlow
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Download SimCLR model during build from OneDrive
RUN mkdir -p /app/models
RUN curl -L -o /app/models/simclr_unet_patch_wound.keras \
    "https://appcific-my.sharepoint.com/:u:/p/nadia_jelani/EbilIS8zT-hHlBW077drk54BsNAyo6hoz5S1WITeSIUxvg?e=Awe24b"

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements_railway.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements_railway.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p uploads reports logs

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose port (Railway will set PORT automatically)
EXPOSE $PORT

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:$PORT/health || exit 1

# Run the application with Gunicorn
CMD ["gunicorn", "-b", "0.0.0.0:${PORT}", "app_free:app", "--timeout", "180", "--workers", "1"]